{
  "name": "groovy",
  "version": "1.0.0",
  "description": "Groovy \u2014 a mobile-first RSS podcast player for Cloudflare Pages and D1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "wrangler pages dev dist",
    "db:migrate": "wrangler d1 migrations apply groovy --local",
    "user": "node scripts/user.mjs",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "5.20261023.1",
    "wrangler": "4.156.0",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=22.13"
  }
}
