{
  "name": "groovy",
  "version": "1.0.0",
  "description": "Groovy \u2014 a mobile-first RSS podcast player for Cloudflare Workers and D1",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "wrangler dev --port 8788",
    "db:migrate": "wrangler d1 migrations apply groovy --local",
    "user": "node scripts/user.mjs",
    "deploy": "npm run build && wrangler deploy",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
